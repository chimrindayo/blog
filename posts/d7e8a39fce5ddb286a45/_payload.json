[{"data":1,"prerenderedAt":31},["ShallowReactive",2],{"useQiitaArticleDetailFetcher":3,"useQiitaAuthorizedUser":29},{"rendered_body":4,"body":5,"coediting":6,"comments_count":7,"created_at":8,"group":9,"id":10,"likes_count":7,"private":6,"reactions_count":7,"stocks_count":7,"tags":11,"title":18,"updated_at":19,"url":20,"user":21,"page_views_count":28,"team_membership":9,"organization_url_name":9,"slide":6},"\u003Ch2 data-sourcepos=\"1:1-1:15\">\n\u003Cspan id=\"はじめに\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%AF%E3%81%98%E3%82%81%E3%81%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>はじめに\u003C/h2>\n\u003Cp data-sourcepos=\"3:1-3:174\">ダビンチリゾルブのエディットを使って動画編集していたら、突然ビデオとオーディオがリンクしなくなったので対処法をメモ。\u003C/p>\n\u003Ch2 data-sourcepos=\"6:1-6:24\">\n\u003Cspan id=\"使用バージョン\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E4%BD%BF%E7%94%A8%E3%83%90%E3%83%BC%E3%82%B8%E3%83%A7%E3%83%B3\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>使用バージョン\u003C/h2>\n\u003Cp data-sourcepos=\"8:1-8:18\">Davinci Resolve 18\u003C/p>\n\u003Ch2 data-sourcepos=\"11:1-11:9\">\n\u003Cspan id=\"事象\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E4%BA%8B%E8%B1%A1\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>事象\u003C/h2>\n\u003Cp data-sourcepos=\"13:1-14:87\">ダビンチリゾルブで動画と音声をリンク🔗している時に\u003Cbr>\nビデオとオーディオを同時に選択して消去してもズレが生じる。\u003C/p>\n\u003Cp data-sourcepos=\"16:1-16:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F303b0db0-ee64-e6f3-6108-f8ab5ce4b713.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=436c2d08e8468a34cb969bb09f4dfcc9\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F303b0db0-ee64-e6f3-6108-f8ab5ce4b713.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=436c2d08e8468a34cb969bb09f4dfcc9\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F303b0db0-ee64-e6f3-6108-f8ab5ce4b713.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=31580a9f5e796d7430472b97f15c9885 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/303b0db0-ee64-e6f3-6108-f8ab5ce4b713.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Ch2 data-sourcepos=\"19:1-19:15\">\n\u003Cspan id=\"解決方法\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E8%A7%A3%E6%B1%BA%E6%96%B9%E6%B3%95\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>解決方法\u003C/h2>\n\u003Cp data-sourcepos=\"21:1-21:66\">オーディオの「自動トラック選択」を有効にする\u003C/p>\n\u003Cp data-sourcepos=\"23:1-23:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F98fba131-4d65-3ccf-3066-b61d1ba4b550.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=cf6e7e2508c40d0535448a892e9bc78a\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F98fba131-4d65-3ccf-3066-b61d1ba4b550.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=cf6e7e2508c40d0535448a892e9bc78a\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F98fba131-4d65-3ccf-3066-b61d1ba4b550.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=61154c84f0f591cda7c436541f54573f 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/98fba131-4d65-3ccf-3066-b61d1ba4b550.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Ch2 data-sourcepos=\"26:1-26:9\">\n\u003Cspan id=\"備考\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E5%82%99%E8%80%83\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>備考\u003C/h2>\n\u003Cp data-sourcepos=\"28:1-28:99\">自動トラック選択を有効にしても解消されない場合は、以下を確認する。\u003C/p>\n\u003Cul data-sourcepos=\"30:1-33:0\">\n\u003Cli data-sourcepos=\"30:1-31:0\">\n\u003Cp data-sourcepos=\"30:3-30:92\">マスター設定とタイムラインのフレームレートが一致しているか？\u003C/p>\n\u003C/li>\n\u003Cli data-sourcepos=\"32:1-33:0\">\n\u003Cp data-sourcepos=\"32:3-32:196\">ビデオーとオーディオのリンク🔗が有効になっているか？以下のボタンを押す or ビデオ上で右クリックして「クリップをリンク」を有効にする\u003C/p>\n\u003C/li>\n\u003C/ul>\n\u003Cp data-sourcepos=\"34:2-35:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2ea8b31d-5ec5-373c-924e-7daa4b9c1e5c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=0aafa8db80019e0fe6103ae78faeade1\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2ea8b31d-5ec5-373c-924e-7daa4b9c1e5c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=0aafa8db80019e0fe6103ae78faeade1\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2ea8b31d-5ec5-373c-924e-7daa4b9c1e5c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=8a81fc2db90a72e2df0121b9948e8f5c 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/2ea8b31d-5ec5-373c-924e-7daa4b9c1e5c.png\" loading=\"lazy\">\u003C/a>\u003Cbr>\n\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F8d9d8a9a-4324-1781-4208-97e9eaa8920c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=b1420cd55fcc054631492d0cbb68d7cb\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F8d9d8a9a-4324-1781-4208-97e9eaa8920c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=b1420cd55fcc054631492d0cbb68d7cb\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F8d9d8a9a-4324-1781-4208-97e9eaa8920c.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=063036ca1fb3e13a34226797815608f6 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/8d9d8a9a-4324-1781-4208-97e9eaa8920c.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n","## はじめに\n\nダビンチリゾルブのエディットを使って動画編集していたら、突然ビデオとオーディオがリンクしなくなったので対処法をメモ。\n\n\n## 使用バージョン\n\nDavinci Resolve 18\n\n\n## 事象\n\nダビンチリゾルブで動画と音声をリンク🔗している時に\nビデオとオーディオを同時に選択して消去してもズレが生じる。\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/303b0db0-ee64-e6f3-6108-f8ab5ce4b713.png)\n\n\n## 解決方法\n\nオーディオの「自動トラック選択」を有効にする\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/98fba131-4d65-3ccf-3066-b61d1ba4b550.png)\n\n\n## 備考\n\n自動トラック選択を有効にしても解消されない場合は、以下を確認する。\n\n- マスター設定とタイムラインのフレームレートが一致しているか？\n\n- ビデオーとオーディオのリンク🔗が有効になっているか？以下のボタンを押す or ビデオ上で右クリックして「クリップをリンク」を有効にする\n\n ![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/2ea8b31d-5ec5-373c-924e-7daa4b9c1e5c.png)\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/8d9d8a9a-4324-1781-4208-97e9eaa8920c.png)\n\n\n\n\n\n\n",false,0,"2023-02-03T00:38:26+09:00",null,"d7e8a39fce5ddb286a45",[12,15],{"name":13,"versions":14},"動画編集",[],{"name":16,"versions":17},"DaVinciResolve",[],"[Davinci Resolve]音声と動画がリンクされない","2023-02-03T13:33:44+09:00","https://qiita.com/chimrindayo/items/d7e8a39fce5ddb286a45",{"description":22,"facebook_id":22,"followees_count":7,"followers_count":7,"github_login_name":9,"id":23,"items_count":24,"linkedin_id":22,"location":22,"name":25,"organization":22,"permanent_id":26,"profile_image_url":27,"team_only":6,"twitter_screen_name":23