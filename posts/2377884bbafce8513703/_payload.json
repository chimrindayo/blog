[{"data":1,"prerenderedAt":30},["ShallowReactive",2],{"useQiitaArticleDetailFetcher":3,"useQiitaAuthorizedUser":28},{"rendered_body":4,"body":5,"coediting":6,"comments_count":7,"created_at":8,"group":9,"id":10,"likes_count":7,"private":6,"reactions_count":7,"stocks_count":7,"tags":11,"title":18,"updated_at":8,"url":19,"user":20,"page_views_count":27,"team_membership":9,"organization_url_name":9,"slide":6},"\u003Ch2 data-sourcepos=\"1:1-1:15\">\n\u003Cspan id=\"はじめに\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%AF%E3%81%98%E3%82%81%E3%81%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>はじめに\u003C/h2>\n\u003Cp data-sourcepos=\"2:1-3:48\">自分がプログラミング学習を進めるうえで、これよかった・面白かったと思うChromeの拡張機能をまとめた備忘録( ..)φ\u003Cbr>\nフロントエンド系の拡張機能が多め\u003C/p>\n\u003Ch2 data-sourcepos=\"5:1-5:15\">\n\u003Cspan id=\"開発共通\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E9%96%8B%E7%99%BA%E5%85%B1%E9%80%9A\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>開発共通\u003C/h2>\n\u003Ch3 data-sourcepos=\"7:1-7:18\">\n\u003Cspan id=\"json-formatter\" class=\"fragment\">\u003C/span>\u003Ca href=\"#json-formatter\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>JSON Formatter\u003C/h3>\n\u003Cp data-sourcepos=\"9:1-9:55\">改行のないJSONを見やすく整形してくれる\u003C/p>\n\u003Cp data-sourcepos=\"11:1-11:94\">\u003Ciframe id=\"qiita-embed-content__a2bdab3e752fef94d0f01054f67dabed\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__a2bdab3e752fef94d0f01054f67dabed\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fjson-formatter%2Fbcjindcccaagfpapjjmafapmmgkkhgoa%3Fpli%3D1\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"13:1-13:41\">\n\u003Cspan id=\"gofullpage---full-page-screen-capture\" class=\"fragment\">\u003C/span>\u003Ca href=\"#gofullpage---full-page-screen-capture\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>GoFullPage - Full Page Screen Capture\u003C/h3>\n\u003Cp data-sourcepos=\"15:1-16:57\">DevToolsだとスクリーンショットを撮りきれないときがあるけど\u003Cbr>\nこれ使うときっちり全画面スクショとれる\u003C/p>\n\u003Cp data-sourcepos=\"18:1-18:93\">撮ったスクショをそのまま画像としてコピペしたりPDFにしたりできる\u003C/p>\n\u003Cp data-sourcepos=\"20:1-20:105\">\u003Ciframe id=\"qiita-embed-content__b10940dba43b751be0863bb601f793d5\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__b10940dba43b751be0863bb601f793d5\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fgofullpage-full-page-scre%2Ffdpohaocaechififmbbbbbknoalclacl%3Fhl%3Dja\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch2 data-sourcepos=\"22:1-22:15\">\n\u003Cspan id=\"情報収集\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E6%83%85%E5%A0%B1%E5%8F%8E%E9%9B%86\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>情報収集\u003C/h2>\n\u003Ch3 data-sourcepos=\"24:1-24:19\">\n\u003Cspan id=\"rss-feed-reader\" class=\"fragment\">\u003C/span>\u003Ca href=\"#rss-feed-reader\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>RSS Feed Reader\u003C/h3>\n\u003Cp data-sourcepos=\"26:1-26:90\">気になる技術情報サイトやテックブログを登録して一気に見られる\u003C/p>\n\u003Cp data-sourcepos=\"28:1-28:118\">\u003Ciframe id=\"qiita-embed-content__8b4bcd15f42c288a77b5c2d5c5f29783\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__8b4bcd15f42c288a77b5c2d5c5f29783\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Frss-feed-reader%2Fpnjaodmkngahhkoihejjehlcdlnohgmp%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"30:1-30:36\">\n\u003Cspan id=\"wappalyzer---technology-profiler\" class=\"fragment\">\u003C/span>\u003Ca href=\"#wappalyzer---technology-profiler\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Wappalyzer - Technology profiler\u003C/h3>\n\u003Cp data-sourcepos=\"32:1-33:48\">各サイトの技術スタックが見られる\u003Cbr>\n単純に見ていて面白いし参考になる\u003C/p>\n\u003Cp data-sourcepos=\"35:1-35:105\">\u003Ciframe id=\"qiita-embed-content__e4e4fe1afd34115d72e6fb6d670edf71\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__e4e4fe1afd34115d72e6fb6d670edf71\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fwappalyzer-technology-pro%2Fgppongmhjkpfnbhagpmjfkannfbllamg%3Fhl%3Dja\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"37:1-37:9\">\n\u003Cspan id=\"deepl\" class=\"fragment\">\u003C/span>\u003Ca href=\"#deepl\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>DeepL\u003C/h3>\n\u003Cp data-sourcepos=\"39:1-39:105\">ブラウザの直訳だとわかりづらい英語の文献とかをいい感じに翻訳してくれる\u003C/p>\n\u003Cp data-sourcepos=\"41:1-41:186\">\u003Ciframe id=\"qiita-embed-content__bc966e8cf1e7cfd2539008e6bbe2efe9\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__bc966e8cf1e7cfd2539008e6bbe2efe9\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fdeepl%25EF%25BC%259Aai%25E7%25BF%25BB%25E8%25A8%25B3%25E3%2581%25A8%25E6%2596%2587%25E7%25AB%25A0%25E4%25BD%259C%25E6%2588%2590%25E3%2583%2584%25E3%2583%25BC%25E3%2583%25AB%2Fcofdbpoegempjloogbagkncekinflcnj%3Fhl%3Dja\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Cp data-sourcepos=\"43:1-43:72\">こんな感じで翻訳したい範囲だけ翻訳できるので便利\u003C/p>\n\u003Cp data-sourcepos=\"45:1-46:40\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F31d374b9-135f-f20e-7b80-b8b285276f19.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=52aa6b127bc53245d0ef2afd13b7506d\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F31d374b9-135f-f20e-7b80-b8b285276f19.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=52aa6b127bc53245d0ef2afd13b7506d\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F31d374b9-135f-f20e-7b80-b8b285276f19.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=948c1b0fab0bfd65e4fc0fe363ebbb0d 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/31d374b9-135f-f20e-7b80-b8b285276f19.png\" loading=\"lazy\">\u003C/a>\u003Cbr>\n引用：\u003Ca href=\"https://www.typescriptlang.org/\" class=\"autolink\" rel=\"nofollow noopener\" target=\"_blank\">https://www.typescriptlang.org/\u003C/a>\u003C/p>\n\u003Ch3 data-sourcepos=\"48:1-48:18\">\n\u003Cspan id=\"save-to-pocket\" class=\"fragment\">\u003C/span>\u003Ca href=\"#save-to-pocket\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Save to Pocket\u003C/h3>\n\u003Cp data-sourcepos=\"49:1-50:102\">後で見たいサイトを一時保存しておける\u003Cbr>\nこれでタブがいっぱい開いていて何がどこにあるかわから～ん！を減らせる\u003C/p>\n\u003Cp data-sourcepos=\"52:1-52:117\">\u003Ciframe id=\"qiita-embed-content__a6d6c230618c93ee259d4179d9ca6b1b\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__a6d6c230618c93ee259d4179d9ca6b1b\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fsave-to-pocket%2Fniloccemoadcdkdjlinkgdfekeahmflj%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"54:1-54:81\">\n\u003Cspan id=\"sider-chatgpt-サイドバー--gpt-4o-claude-35-gemini-15--aiツール\" class=\"fragment\">\u003C/span>\u003Ca href=\"#sider-chatgpt-%E3%82%B5%E3%82%A4%E3%83%89%E3%83%90%E3%83%BC--gpt-4o-claude-35-gemini-15--ai%E3%83%84%E3%83%BC%E3%83%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Sider: ChatGPT サイドバー + GPT-4o, Claude 3.5, Gemini 1.5 &amp; AIツール\u003C/h3>\n\u003Cp data-sourcepos=\"56:1-57:48\">サイドバーでChatGPTと会話しながら作業できる\u003Cbr>\nサイトの要約とかすぐにできて便利\u003C/p>\n\u003Cp data-sourcepos=\"59:1-59:168\">\u003Ciframe id=\"qiita-embed-content__36bf4f20000f8d595d101e93d128ffa3\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__36bf4f20000f8d595d101e93d128ffa3\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fsider-chatgpt-%25E3%2582%25B5%25E3%2582%25A4%25E3%2583%2589%25E3%2583%2590%25E3%2583%25BC-%2B-gpt%2Fdifoiogjjojoaoomphldepapgpbgkhkb%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch2 data-sourcepos=\"61:1-61:30\">\n\u003Cspan id=\"フロントエンド関連\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%83%95%E3%83%AD%E3%83%B3%E3%83%88%E3%82%A8%E3%83%B3%E3%83%89%E9%96%A2%E9%80%A3\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>フロントエンド関連\u003C/h2>\n\u003Ch3 data-sourcepos=\"62:1-62:20\">\n\u003Cspan id=\"tdk-meta-checker\" class=\"fragment\">\u003C/span>\u003Ca href=\"#tdk-meta-checker\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>TDK Meta Checker\u003C/h3>\n\u003Cp data-sourcepos=\"63:1-64:71\">meta情報の確認に使う\u003Cbr>\nog:imageが正常に設定されているかどうかの確認に使う\u003C/p>\n\u003Cp data-sourcepos=\"66:1-66:96\">\u003Ciframe id=\"qiita-embed-content__c8a930e602b2e2d2bbfedc29f612f4a5\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__c8a930e602b2e2d2bbfedc29f612f4a5\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Ftdk-meta-checker%2Fkjiieeppkcjgdigogiafneikdhpagpbc%3Fhl%3Dja\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"68:1-68:23\">\n\u003Cspan id=\"seo-meta-in-1-click\" class=\"fragment\">\u003C/span>\u003Ca href=\"#seo-meta-in-1-click\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>SEO META in 1 CLICK\u003C/h3>\n\u003Cp data-sourcepos=\"69:1-71:103\">meta情報の確認に使う\u003Cbr>\nサイトで使っているhタグの個数がわかったり、リンク一覧が見られたりする。\u003Cbr>\ntitleやdescriptionの文字数が適切でない場合は、赤字で警告っぽく表記される。\u003C/p>\n\u003Cp data-sourcepos=\"73:1-73:122\">\u003Ciframe id=\"qiita-embed-content__3c58dea7097b18ef44d73cff544ef05b\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__3c58dea7097b18ef44d73cff544ef05b\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fseo-meta-in-1-click%2Fbjogjfinolnhfhkbipphpdlldadpnmhc%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"75:1-75:21\">\n\u003Cspan id=\"responsive-viewer\" class=\"fragment\">\u003C/span>\u003Ca href=\"#responsive-viewer\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Responsive Viewer\u003C/h3>\n\u003Cp data-sourcepos=\"76:1-76:59\">SPなどのレスポンシブデザインの確認に使う\u003C/p>\n\u003Cp data-sourcepos=\"78:1-78:120\">\u003Ciframe id=\"qiita-embed-content__7c6ed9257b2bbfde9f3d667aee7a0bd4\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__7c6ed9257b2bbfde9f3d667aee7a0bd4\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fresponsive-viewer%2Finmopeiepgfljkpkidclfgbgbmfcennb%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"80:1-80:76\">\n\u003Cspan id=\"モバイルシミュレーター---レスポンシブテストツール\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%83%A2%E3%83%90%E3%82%A4%E3%83%AB%E3%82%B7%E3%83%9F%E3%83%A5%E3%83%AC%E3%83%BC%E3%82%BF%E3%83%BC---%E3%83%AC%E3%82%B9%E3%83%9D%E3%83%B3%E3%82%B7%E3%83%96%E3%83%86%E3%82%B9%E3%83%88%E3%83%84%E3%83%BC%E3%83%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>モバイルシミュレーター - レスポンシブテストツール\u003C/h3>\n\u003Cp data-sourcepos=\"81:1-82:57\">これもSPなどのレスポンシブデザインの確認に使う\u003Cbr>\n個人的にはこの拡張機能が見やすくて好き\u003C/p>\n\u003Cp data-sourcepos=\"84:1-84:311\">\u003Ciframe id=\"qiita-embed-content__646b5710b32db2147772b6448e929847\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__646b5710b32db2147772b6448e929847\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2F%25E3%2583%25A2%25E3%2583%2590%25E3%2582%25A4%25E3%2583%25AB%25E3%2582%25B7%25E3%2583%259F%25E3%2583%25A5%25E3%2583%25AC%25E3%2583%25BC%25E3%2582%25BF%25E3%2583%25BC-%25E3%2583%25AC%25E3%2582%25B9%25E3%2583%259D%25E3%2583%25B3%25E3%2582%25B7%25E3%2583%2596%25E3%2583%2586%25E3%2582%25B9%25E3%2583%2588%25E3%2583%2584%25E3%2583%25BC%25E3%2583%25AB%2Fckejmhbmlajgoklhgbapkiccekfoccmk%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"86:1-86:14\">\n\u003Cspan id=\"colorzilla\" class=\"fragment\">\u003C/span>\u003Ca href=\"#colorzilla\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>ColorZilla\u003C/h3>\n\u003Cp data-sourcepos=\"87:1-88:24\">サイトで使われているカラーコードの確認に使う\u003Cbr>\nこれ楽しくてすき\u003C/p>\n\u003Cp data-sourcepos=\"90:1-90:113\">\u003Ciframe id=\"qiita-embed-content__ee7a3702c556d88a8efe6e5fa3363643\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__ee7a3702c556d88a8efe6e5fa3363643\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fcolorzilla%2Fbhlhnicpbhignbdhedgjhgdocnmhomnp%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"92:1-92:12\">\n\u003Cspan id=\"whatfont\" class=\"fragment\">\u003C/span>\u003Ca href=\"#whatfont\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>WhatFont\u003C/h3>\n\u003Cp data-sourcepos=\"93:1-94:27\">サイトで使われているフォント・フォントサイズ・ウェイト・カラーなどがわかる\u003Cbr>\nこれも面白くてすき\u003C/p>\n\u003Cp data-sourcepos=\"96:1-96:88\">\u003Ciframe id=\"qiita-embed-content__e5de46cee4fabaecbaf25f46459ff64e\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__e5de46cee4fabaecbaf25f46459ff64e\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fwhatfont%2Fjabopobgcpjmedljpbcaablpmlmfcogm%3Fhl%3Dja\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"98:1-98:15\">\n\u003Cspan id=\"headingsmap\" class=\"fragment\">\u003C/span>\u003Ca href=\"#headingsmap\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>HeadingsMap\u003C/h3>\n\u003Cp data-sourcepos=\"99:1-100:57\">hタグが適切に設定されているか確認するのに使う\u003Cbr>\n各見出しが階層で表示されるので見やすい\u003C/p>\n\u003Cp data-sourcepos=\"102:1-102:114\">\u003Ciframe id=\"qiita-embed-content__4f6a9180c123dbb2f3dc8d523e9dd1c0\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__4f6a9180c123dbb2f3dc8d523e9dd1c0\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fheadingsmap%2Fflbjommegcjonpdmenkdiocclhjacmbi%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Cp data-sourcepos=\"104:1-104:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F9ca1a189-9c60-8472-9575-5d142d8b453d.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=4975b36c2305388400ecb8d4b6783224\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F9ca1a189-9c60-8472-9575-5d142d8b453d.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=4975b36c2305388400ecb8d4b6783224\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F9ca1a189-9c60-8472-9575-5d142d8b453d.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=02e52bff6991cb7063523381bce84f33 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/9ca1a189-9c60-8472-9575-5d142d8b453d.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Ch3 data-sourcepos=\"106:1-106:14\">\n\u003Cspan id=\"lighthouse\" class=\"fragment\">\u003C/span>\u003Ca href=\"#lighthouse\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Lighthouse\u003C/h3>\n\u003Cp data-sourcepos=\"107:1-108:59\">パフォーマンス改善に利用する\u003Cbr>\nPageSpeedInsightsのレポートが出力できたりする\u003C/p>\n\u003Cp data-sourcepos=\"110:1-110:113\">\u003Ciframe id=\"qiita-embed-content__4be3386f01df395af3c22b95a12f8332\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__4be3386f01df395af3c22b95a12f8332\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Flighthouse%2Fblipmdconlkpinefehnmjammfjpmpbjk%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch2 data-sourcepos=\"112:1-112:27\">\n\u003Cspan id=\"バックエンド関連\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%83%90%E3%83%83%E3%82%AF%E3%82%A8%E3%83%B3%E3%83%89%E9%96%A2%E9%80%A3\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>バックエンド関連\u003C/h2>\n\u003Ch3 data-sourcepos=\"113:1-113:36\">\n\u003Cspan id=\"talend-api-tester---free-edition\" class=\"fragment\">\u003C/span>\u003Ca href=\"#talend-api-tester---free-edition\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Talend API Tester - Free Edition\u003C/h3>\n\u003Cp data-sourcepos=\"114:1-114:24\">APIのテストに使う\u003C/p>\n\u003Cp data-sourcepos=\"116:1-116:99\">\u003Ciframe id=\"qiita-embed-content__63ec6089c9ce9107db1871d674d0d0dc\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__63ec6089c9ce9107db1871d674d0d0dc\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Ftalend-api-tester-free-ed%2Faejoelaoggembcahagimdiliamlcdmfm\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch2 data-sourcepos=\"118:1-118:12\">\n\u003Cspan id=\"その他\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%9D%E3%81%AE%E4%BB%96\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>その他\u003C/h2>\n\u003Ch3 data-sourcepos=\"120:1-120:58\">\n\u003Cspan id=\"custom-cursor-for-chrome---カスタムカーソル\" class=\"fragment\">\u003C/span>\u003Ca href=\"#custom-cursor-for-chrome---%E3%82%AB%E3%82%B9%E3%82%BF%E3%83%A0%E3%82%AB%E3%83%BC%E3%82%BD%E3%83%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>Custom Cursor for Chrome™ - カスタムカーソル\u003C/h3>\n\u003Cp data-sourcepos=\"122:1-123:120\">人に何かを説明したいとき、大き目のカーソルに設定しておくと見やすい。\u003Cbr>\n（個人的には、よくモニター上でカーソルを見失うので大きめのカーソルを使っている）\u003C/p>\n\u003Cp data-sourcepos=\"125:1-125:127\">\u003Ciframe id=\"qiita-embed-content__bc0fda84e1af3cb04ffd259705c1f59e\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__bc0fda84e1af3cb04ffd259705c1f59e\" data-content=\"https%3A%2F%2Fchromewebstore.google.com%2Fdetail%2Fcustom-cursor-for-chrome%2Fogdlpmhglpejoiomcodnpjnfgcpmgale%3Fhl%3Dja%26utm_source%3Dext_sidebar\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch1 data-sourcepos=\"127:1-127:14\">\n\u003Cspan id=\"さいごに\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%95%E3%81%84%E3%81%94%E3%81%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>さいごに\u003C/h1>\n\u003Cp data-sourcepos=\"129:1-129:295\">改めて拡張機能を使ったことのある拡張機能を整理してみたら、使いこなせていない機能も多いなと思った🤔そして、拡張機能を使いこなしてもっと作業効率上げられたら面倒に感じる作業も楽しくできそう・・・？！\u003C/p>\n\u003Cp data-sourcepos=\"132:1-132:138\">他にもたくさん便利な拡張機能はあると思うので、これからも時間があるときに探して試してみたい！\u003C/p>\n","## はじめに\n自分がプログラミング学習を進めるうえで、これよかった・面白かったと思うChromeの拡張機能をまとめた備忘録( ..)φ\nフロントエンド系の拡張機能が多め\n\n## 開発共通\n\n### JSON Formatter\n\n改行のないJSONを見やすく整形してくれる\n\nhttps://chromewebstore.google.com/detail/json-formatter/bcjindcccaagfpapjjmafapmmgkkhgoa?pli=1\n\n### GoFullPage - Full Page Screen Capture\n\nDevToolsだとスクリーンショットを撮りきれないときがあるけど\nこれ使うときっちり全画面スクショとれる\n\n撮ったスクショをそのまま画像としてコピペしたりPDFにしたりできる\n\nhttps://chromewebstore.google.com/detail/gofullpage-full-page-scre/fdpohaocaechififmbbbbbknoalclacl?hl=ja\n\n## 情報収集\n\n### RSS Feed Reader\n\n気になる技術情報サイトやテックブログを登録して一気に見られる\n\nhttps://chromewebstore.google.com/detail/rss-feed-reader/pnjaodmkngahhkoihejjehlcdlnohgmp?hl=ja&utm_source=ext_sidebar\n\n### Wappalyzer - Technology profiler\n\n各サイトの技術スタックが見られる\n単純に見ていて面白いし参考になる\n\nhttps://chromewebstore.google.com/detail/wappalyzer-technology-pro/gppongmhjkpfnbhagpmjfkannfbllamg?hl=ja\n\n### DeepL\n\nブラウザの直訳だとわかりづらい英語の文献とかをいい感じに翻訳してくれる\n\nhttps://chromewebstore.google.com/detail/deepl%EF%BC%9Aai%E7%BF%BB%E8%A8%B3%E3%81%A8%E6%96%87%E7%AB%A0%E4%BD%9C%E6%88%90%E3%83%84%E3%83%BC%E3%83%AB/cofdbpoegempjloogbagkncekinflcnj?hl=ja\n\nこんな感じで翻訳したい範囲だけ翻訳できるので便利\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/31d374b9-135f-f20e-7b80-b8b285276f19.png)\n引用：https://www.typescriptlang.org/\n\n### Save to Pocket\n後で見たいサイトを一時保存しておける\nこれでタブがいっぱい開いていて何がどこにあるかわから～ん！を減らせる\n\nhttps://chromewebstore.google.com/detail/save-to-pocket/niloccemoadcdkdjlinkgdfekeahmflj?hl=ja&utm_source=ext_sidebar\n\n### Sider: ChatGPT サイドバー + GPT-4o, Claude 3.5, Gemini 1.5 & AIツール\n\nサイドバーでChatGPTと会話しながら作業できる\nサイトの要約とかすぐにできて便利\n\nhttps://chromewebstore.google.com/detail/sider-chatgpt-%E3%82%B5%E3%82%A4%E3%83%89%E3%83%90%E3%83%BC-+-gpt/difoiogjjojoaoomphldepapgpbgkhkb?hl=ja&utm_source=ext_sidebar\n\n## フロントエンド関連\n### TDK Meta Checker\nmeta情報の確認に使う\nog:imageが正常に設定されているかどうかの確認に使う\n\nhttps://chromewebstore.google.com/detail/tdk-meta-checker/kjiieeppkcjgdigogiafneikdhpagpbc?hl=ja\n\n### SEO META in 1 CLICK\nmeta情報の確認に使う\nサイトで使っているhタグの個数がわかったり、リンク一覧が見られたりする。\ntitleやdescriptionの文字数が適切でない場合は、赤字で警告っぽく表記される。\n\nhttps://chromewebstore.google.com/detail/seo-meta-in-1-click/bjogjfinolnhfhkbipphpdlldadpnmhc?hl=ja&utm_source=ext_sidebar\n\n### Responsive Viewer\nSPなどのレスポンシブデザインの確認に使う\n\nhttps://chromewebstore.google.com/detail/responsive-viewer/inmopeiepgfljkpkidclfgbgbmfcennb?hl=ja&utm_source=ext_sidebar\n\n### モバイルシミュレーター - レスポンシブテストツール\nこれもSPなどのレスポンシブデザインの確認に使う\n個人的にはこの拡張機能が見やすくて好き\n\nhttps://chromewebstore.google.com/detail/%E3%83%A2%E3%83%90%E3%82%A4%E3%83%AB%E3%82%B7%E3%83%9F%E3%83%A5%E3%83%AC%E3%83%BC%E3%82%BF%E3%83%BC-%E3%83%AC%E3%82%B9%E3%83%9D%E3%83%B3%E3%82%B7%E3%83%96%E3%83%86%E3%82%B9%E3%83%88%E3%83%84%E3%83%BC%E3%83%AB/ckejmhbmlajgoklhgbapkiccekfoccmk?hl=ja&utm_source=ext_sidebar\n\n### ColorZilla\nサイトで使われているカラーコードの確認に使う\nこれ楽しくてすき\n\nhttps://chromewebstore.google.com/detail/colorzilla/bhlhnicpbhignbdhedgjhgdocnmhomnp?hl=ja&utm_source=ext_sidebar\n\n### WhatFont\nサイトで使われているフォント・フォントサイズ・ウェイト・カラーなどがわかる\nこれも面白くてすき\n\nhttps://chromewebstore.google.com/detail/whatfont/jabopobgcpjmedljpbcaablpmlmfcogm?hl=ja\n\n### HeadingsMap\nhタグが適切に設定されているか確認するのに使う\n各見出しが階層で表示されるので見やすい\n\nhttps://chromewebstore.google.com/detail/headingsmap/flbjommegcjonpdmenkdiocclhjacmbi?hl=ja&utm_source=ext_sidebar\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/9ca1a189-9c60-8472-9575-5d142d8b453d.png)\n\n### Lighthouse\nパフォーマンス改善に利用する\nPageSpeedInsightsのレポートが出力できたりする\n\nhttps://chromewebstore.google.com/detail/lighthouse/blipmdconlkpinefehnmjammfjpmpbjk?hl=ja&utm_source=ext_sidebar\n\n## バックエンド関連\n### Talend API Tester - Free Edition\nAPIのテストに使う\n\nhttps://chromewebstore.google.com/detail/talend-api-tester-free-ed/aejoelaoggembcahagimdiliamlcdmfm\n\n## その他\n\n### Custom Cursor for Chrome™ - カスタムカーソル\n\n人に何かを説明したいとき、大き目のカーソルに設定しておくと見やすい。\n（個人的には、よくモニター上でカーソルを見失うので大きめのカーソルを使っている）\n\nhttps://chromewebstore.google.com/detail/custom-cursor-for-chrome/ogdlpmhglpejoiomcodnpjnfgcpmgale?hl=ja&utm_source=ext_sidebar\n\n# さいごに\n\n改めて拡張機能を使ったことのある拡張機能を整理してみたら、使いこなせていない機能も多いなと思った🤔そして、拡張機能を使いこなしてもっと作業効率上げられたら面倒に感じる作業も楽しくできそう・・・？！\n\n\n他にもたくさん便利な拡張機能はあると思うので、これからも時間があるときに探して試してみたい！\n",false,0,"2024-12-03T07:25:13+09:00",null,"2377884bbafce8513703",[12,15],{"name":13,"versions":14},"Chrome",[],{"name":16,"versions":17},"chrome-extension",[],"開発使える便利なChrome拡張機能","https://qiita.com/chimrindayo/items/2377884bbafce8513703",{"description":21,"facebook_id":21,"followees_count":7,"followers_count":7,"github_login_name":9,"id":22,"items_count":23,"linkedin_id":21,"location":21,"name":24,"organization":21,"permanent_id":25,"profile_image_url":26,"team_only":6,"twitter_screen_name":22,"website_url":21},"","chimrindayo",17,"chimrin",667288,"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/profile-images/1731046053",282,{"description":21,"facebook_id":21,"followees_count":7,"followers_count":7,"github_login_name":9,"id":22,"items_count":23,"linkedin_id":21,"location":21,"name":24,"organization":21,"permanent_id":25,"profile_image_url":26,"team_only":6,"twitter_screen_name":22,"website_url":21,"image_monthly_upload_limit":29,"image_monthly_upload_remaining":29},104857600,1744278644746]