[{"data":1,"prerenderedAt":27},["ShallowReactive",2],{"useQiitaArticleDetailFetcher":3,"useQiitaAuthorizedUser":25},{"rendered_body":4,"body":5,"coediting":6,"comments_count":7,"created_at":8,"group":9,"id":10,"likes_count":7,"private":6,"reactions_count":7,"stocks_count":7,"tags":11,"title":15,"updated_at":8,"url":16,"user":17,"page_views_count":24,"team_membership":9,"organization_url_name":9,"slide":6},"\u003Ch2 data-sourcepos=\"1:1-1:15\">\n\u003Cspan id=\"はじめに\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%AF%E3%81%98%E3%82%81%E3%81%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>はじめに\u003C/h2>\n\u003Cp data-sourcepos=\"2:1-2:88\">サイト開発をデザインからチャレンジしてみたい！第2弾の記事。\u003C/p>\n\u003Cp data-sourcepos=\"4:1-6:138\">最初は、ムードボードにチャレンジしてみた。\u003Cbr>\n本来であればもっと情報を細かく列挙して検討・整理するものだと思うけれど、\u003Cbr>\n今回は、初挑戦かつ全体的な概要をつかみたいので、大まかに（？）デザインの流れを体験してみる。\u003C/p>\n\u003Cp data-sourcepos=\"8:1-8:56\">\u003Ciframe id=\"qiita-embed-content__77e717af288e3662146a643ff3819150\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__77e717af288e3662146a643ff3819150\" data-content=\"https%3A%2F%2Fqiita.com%2Fchimrindayo%2Fitems%2Fcb8cdbdb2490fff81289\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch2 data-sourcepos=\"11:1-11:42\">\n\u003Cspan id=\"デザインコンセプトを考える\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%83%87%E3%82%B6%E3%82%A4%E3%83%B3%E3%82%B3%E3%83%B3%E3%82%BB%E3%83%97%E3%83%88%E3%82%92%E8%80%83%E3%81%88%E3%82%8B\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>デザインコンセプトを考える\u003C/h2>\n\u003Cp data-sourcepos=\"12:1-12:60\">今日は参考となるデザインを収集してみる。\u003C/p>\n\u003Cp data-sourcepos=\"14:1-14:241\">前にデザイナーさんと雑談していたときに、「Pinterestとかでデザインのイメージを教えてほしい」と言われたのをふと思い出したので、Pinterestで情報収集にチャレンジしてみる💡\u003C/p>\n\u003Cp data-sourcepos=\"17:1-17:102\">(っ'ヮ'c)＜ なにこれ見てるだけで楽しくて保存する手が止まらない・・・！\u003C/p>\n\u003Cp data-sourcepos=\"19:1-20:45\">すべてが素敵すぎて保存する手が止まらないし、ずっと見ていられる。\u003Cbr>\nでもこれすっごく難しいな、、、\u003C/p>\n\u003Cp data-sourcepos=\"22:1-23:121\">気に入ったものを何個かピンしてみた\u003Cbr>\n\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2659426f-6ef6-b335-2b87-fc9e1e057ece.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=aa3e2b31c004a792d95a749f4fdc38dd\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2659426f-6ef6-b335-2b87-fc9e1e057ece.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=aa3e2b31c004a792d95a749f4fdc38dd\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2F2659426f-6ef6-b335-2b87-fc9e1e057ece.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=bbc2842f914415564c7134a52582b82b 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/2659426f-6ef6-b335-2b87-fc9e1e057ece.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Cp data-sourcepos=\"25:1-25:136\">今回は私のプロフィールアイコンと同じ8bitっぽく宇宙感のある（？）雰囲気にしていきたいと思う。\u003C/p>\n\u003Ch2 data-sourcepos=\"27:1-27:30\">\n\u003Cspan id=\"レイアウトを考える\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%83%AC%E3%82%A4%E3%82%A2%E3%82%A6%E3%83%88%E3%82%92%E8%80%83%E3%81%88%E3%82%8B\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>レイアウトを考える\u003C/h2>\n\u003Cp data-sourcepos=\"28:1-29:99\">まずは、Figmaを使ってワイヤーフレームをこんな感じで考えてみた。\u003Cbr>\n見やすさに不安は残るが、一旦このレイアウトで実装してみたいと思う。\u003C/p>\n\u003Cp data-sourcepos=\"31:1-31:220\">トップページは、左ペインにプロフィールを表示して、右ペインをカード形式で記事のリンクを表示するイメージする。PCメインで考えるので、SPは後回しにする。\u003C/p>\n\u003Cp data-sourcepos=\"33:1-33:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Fafe99e07-8b11-290f-969a-ac332a79792b.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=fc49a48c352ede77ed92a9ed2db360b8\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Fafe99e07-8b11-290f-969a-ac332a79792b.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=fc49a48c352ede77ed92a9ed2db360b8\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Fafe99e07-8b11-290f-969a-ac332a79792b.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=98164d50b3b8646b447dd70b47cc495d 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/afe99e07-8b11-290f-969a-ac332a79792b.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Cp data-sourcepos=\"36:1-38:93\">記事ページはこんな感じ。\u003Cbr>\n左にカテゴリを表示して、右はサムネイル（MV）と本文の予定。\u003Cbr>\nトップも記事のページも右ペインだけ、スクロールできるイメージ。\u003C/p>\n\u003Cp data-sourcepos=\"40:1-40:121\">\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ffa8d5a66-db67-a47a-8303-4e8c73fff5e9.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=64ddddc8325b85526f6f73c130b50689\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ffa8d5a66-db67-a47a-8303-4e8c73fff5e9.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=64ddddc8325b85526f6f73c130b50689\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ffa8d5a66-db67-a47a-8303-4e8c73fff5e9.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=a638002f6554c3d854be4e6b088b5250 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/fa8d5a66-db67-a47a-8303-4e8c73fff5e9.png\" loading=\"lazy\">\u003C/a>\u003C/p>\n\u003Cp data-sourcepos=\"42:1-43:96\">自分で作った後に気づいたけど、RSS Readerと同じようなレイアウトだから意外と見やすいかもしれない💡\u003Cbr>\nマージンとかは、あまり気にして作っていないので、のちに調整する。\u003C/p>\n\u003Ch2 data-sourcepos=\"45:1-45:12\">\n\u003Cspan id=\"まとめ\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E3%81%BE%E3%81%A8%E3%82%81\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>まとめ\u003C/h2>\n\u003Cp data-sourcepos=\"46:1-48:126\">今日は、Pinterestで参考となるデザインの収集とワイヤーフレームまで検討してみた。\u003Cbr>\nPinterestで情報収集したり、色を検討したりするの慣れなくてすごく難しい。\u003Cbr>\n見る人に与える印象や、見やすさ・アクセシビリティとか考えること色々あって勉強になる。\u003C/p>\n\u003Cp data-sourcepos=\"50:1-51:58\">明日は実際のデザインに取りかかる予定！\u003Cbr>\n（金曜なのでいっぱいがんばれそう😊！）\u003C/p>\n","## はじめに\nサイト開発をデザインからチャレンジしてみたい！第2弾の記事。\n\n最初は、ムードボードにチャレンジしてみた。\n本来であればもっと情報を細かく列挙して検討・整理するものだと思うけれど、\n今回は、初挑戦かつ全体的な概要をつかみたいので、大まかに（？）デザインの流れを体験してみる。\n\nhttps://qiita.com/chimrindayo/items/cb8cdbdb2490fff81289\n\n\n## デザインコンセプトを考える\n今日は参考となるデザインを収集してみる。\n\n前にデザイナーさんと雑談していたときに、「Pinterestとかでデザインのイメージを教えてほしい」と言われたのをふと思い出したので、Pinterestで情報収集にチャレンジしてみる💡\n\n\n(っ'ヮ'c)＜ なにこれ見てるだけで楽しくて保存する手が止まらない・・・！\n\nすべてが素敵すぎて保存する手が止まらないし、ずっと見ていられる。\nでもこれすっごく難しいな、、、\n\n気に入ったものを何個かピンしてみた\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/2659426f-6ef6-b335-2b87-fc9e1e057ece.png)\n\n今回は私のプロフィールアイコンと同じ8bitっぽく宇宙感のある（？）雰囲気にしていきたいと思う。\n\n## レイアウトを考える\nまずは、Figmaを使ってワイヤーフレームをこんな感じで考えてみた。\n見やすさに不安は残るが、一旦このレイアウトで実装してみたいと思う。\n\nトップページは、左ペインにプロフィールを表示して、右ペインをカード形式で記事のリンクを表示するイメージする。PCメインで考えるので、SPは後回しにする。\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/afe99e07-8b11-290f-969a-ac332a79792b.png)\n\n\n記事ページはこんな感じ。\n左にカテゴリを表示して、右はサムネイル（MV）と本文の予定。\nトップも記事のページも右ペインだけ、スクロールできるイメージ。\n\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/fa8d5a66-db67-a47a-8303-4e8c73fff5e9.png)\n\n自分で作った後に気づいたけど、RSS Readerと同じようなレイアウトだから意外と見やすいかもしれない💡\nマージンとかは、あまり気にして作っていないので、のちに調整する。\n\n## まとめ\n今日は、Pinterestで参考となるデザインの収集とワイヤーフレームまで検討してみた。\nPinterestで情報収集したり、色を検討したりするの慣れなくてすごく難しい。\n見る人に与える印象や、見やすさ・アクセシビリティとか考えること色々あって勉強になる。\n\n明日は実際のデザインに取りかかる予定！\n（金曜なのでいっぱいがんばれそう😊！）\n",false,0,"2024-12-06T04:32:11+09:00",null,"3a44db82b02aef1190a3",[12],{"name":13,"versions":14},"Design",[],"デザインコンセプトを決めたい","https://qiita.com/chimrindayo/items/3a44db82b02aef1190a3",{"description":18,"facebook_id":18,"followees_count":7,"followers_count":7,"github_login_name":9,"id":19,"items_count":20,"linkedin_id":18,"location":18,"name":21,"organization":18,"permanent_id":22,"profile_image_url":23,"team_only":6,"twitter_screen_name":19,"website_url":18},"","chimrindayo",17,"chimrin",667288,"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/profile-images/1731046053",115,{"description":18,"facebook_id":18,"followees_count":7,"followers_count":7,"github_login_name":9,"id":19,"items_count":20,"linkedin_id":18,"location":18,"name":21,"organization":18,"permanent_id":22,"profile_image_url":23,"team_only":6,"twitter_screen_name":19,"website_url":18,"image_monthly_upload_limit":26,"image_monthly_upload_remaining":26},104857600,1744278644745]