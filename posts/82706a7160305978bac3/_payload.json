[{"data":1,"prerenderedAt":40},["ShallowReactive",2],{"useQiitaArticleDetailFetcher":3,"useQiitaAuthorizedUser":38},{"rendered_body":4,"body":5,"coediting":6,"comments_count":7,"created_at":8,"group":9,"id":10,"likes_count":7,"private":6,"reactions_count":7,"stocks_count":11,"tags":12,"title":28,"updated_at":8,"url":29,"user":30,"page_views_count":37,"team_membership":9,"organization_url_name":9,"slide":6},"\u003Ch2 data-sourcepos=\"1:1-1:9\">\n\u003Cspan id=\"概要\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E6%A6%82%E8%A6%81\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>概要\u003C/h2>\n\u003Cul data-sourcepos=\"2:1-4:0\">\n\u003Cli data-sourcepos=\"2:1-2:59\">VSCodeからGitを使えるようにした際の備忘録\u003C/li>\n\u003Cli data-sourcepos=\"3:1-4:0\">VSCodeとGit連携しておくと、Gitのコマンド入力（Pull/Push..etc)やブランチのチェックアウトが簡単にできるので便利◎\u003C/li>\n\u003C/ul>\n\u003Ch2 data-sourcepos=\"5:1-5:9\">\n\u003Cspan id=\"環境\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E7%92%B0%E5%A2%83\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>環境\u003C/h2>\n\u003Cul data-sourcepos=\"6:1-12:0\">\n\u003Cli data-sourcepos=\"6:1-6:30\">Windows10 Home  x64-based PC\u003C/li>\n\u003Cli data-sourcepos=\"7:1-7:20\">Ubuntu 20.04.2 LTS\u003C/li>\n\u003Cli data-sourcepos=\"8:1-8:30\">git version 2.32.0.windows.1\u003C/li>\n\u003Cli data-sourcepos=\"9:1-12:0\">Visual Studio Code ver:1.57.1\u003C/li>\n\u003C/ul>\n\u003Ch2 data-sourcepos=\"13:1-13:15\">\n\u003Cspan id=\"実施内容\" class=\"fragment\">\u003C/span>\u003Ca href=\"#%E5%AE%9F%E6%96%BD%E5%86%85%E5%AE%B9\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>実施内容\u003C/h2>\n\u003Ch3 data-sourcepos=\"14:1-14:27\">\n\u003Cspan id=\"1gitインストール\" class=\"fragment\">\u003C/span>\u003Ca href=\"#1git%E3%82%A4%E3%83%B3%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>1.Gitインストール\u003C/h3>\n\u003Cul data-sourcepos=\"16:1-17:0\">\n\u003Cli data-sourcepos=\"16:1-17:0\">↓の手順でGitをインストール\u003C/li>\n\u003C/ul>\n\u003Cp data-sourcepos=\"18:1-18:52\">\u003Ciframe id=\"qiita-embed-content__09690201c636c0148e310d77304ad433\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__09690201c636c0148e310d77304ad433\" data-content=\"https%3A%2F%2Fqiita.com%2FnutsOst%2Fitems%2F86d00e6f31a66210b5da\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Cul data-sourcepos=\"20:1-21:0\">\n\u003Cli data-sourcepos=\"20:1-21:0\">↓のコマンドを実行 (Ubuntu上で実行した)\u003C/li>\n\u003C/ul>\n\u003Cdiv class=\"code-frame\" data-lang=\"text\" data-sourcepos=\"22:1-25:3\">\u003Cdiv class=\"highlight\">\u003Cpre>\u003Ccode>git config --global user.name {ユーザー名}\ngit config --global user.email {メールアドレス}\n\u003C/code>\u003C/pre>\u003C/div>\u003C/div>\n\u003Ch3 data-sourcepos=\"27:1-27:30\">\n\u003Cspan id=\"2vscodeインストール\" class=\"fragment\">\u003C/span>\u003Ca href=\"#2vscode%E3%82%A4%E3%83%B3%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AB\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>2.VSCodeインストール\u003C/h3>\n\u003Cp data-sourcepos=\"29:1-29:60\">↓のリンクからVisual Studio Codeをインストール\u003C/p>\n\u003Cp data-sourcepos=\"31:1-31:62\">\u003Ciframe id=\"qiita-embed-content__004434870332bbda201027c2dfa9feed\" src=\"https://qiita.com/embed-contents/link-card#qiita-embed-content__004434870332bbda201027c2dfa9feed\" data-content=\"https%3A%2F%2Fazure.microsoft.com%2Fja-jp%2Fproducts%2Fvisual-studio-code%2F\" frameborder=\"0\" scrolling=\"no\" loading=\"lazy\" style=\"width:100%;\" height=\"29\">\n\u003C/iframe>\n\u003C/p>\n\u003Ch3 data-sourcepos=\"33:1-33:12\">\n\u003Cspan id=\"3連携\" class=\"fragment\">\u003C/span>\u003Ca href=\"#3%E9%80%A3%E6%90%BA\">\u003Ci class=\"fa fa-link\">\u003C/i>\u003C/a>3.連携\u003C/h3>\n\u003Cul data-sourcepos=\"35:1-38:2\">\n\u003Cli data-sourcepos=\"35:1-35:41\">任意のフォルダをVSCodeで開く\u003C/li>\n\u003Cli data-sourcepos=\"36:1-36:46\">\n\u003Ccode>Ctrl+Shift+@\u003C/code> でターミナルを開く\u003C/li>\n\u003Cli data-sourcepos=\"37:1-37:41\">ターミナルで\u003Ccode>git init\u003C/code>を実行\u003C/li>\n\u003Cli data-sourcepos=\"38:1-38:2\">\n\u003C/ul>\n\u003Cdiv class=\"code-frame\" data-lang=\"text\" data-sourcepos=\"39:1-43:3\">\u003Cdiv class=\"highlight\">\u003Cpre>\u003Ccode>実行結果\nPS C:\\Users\\~~&gt; git init\nInitialized empty Git repository in C:/Users/~~/.git/\n\u003C/code>\u003C/pre>\u003C/div>\u003C/div>\n\u003Cul data-sourcepos=\"45:1-55:0\">\n\u003Cli data-sourcepos=\"45:1-55:0\">左下に↓のようにBranch名が表示されていればOK\u003Cbr>\n\u003Ca href=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ff894538b-39d3-f7ca-53ce-ddf34a27f84f.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=0ac330eb7bf2b5780caca3aa8c382c02\" target=\"_blank\" rel=\"nofollow noopener\">\u003Cimg src=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ff894538b-39d3-f7ca-53ce-ddf34a27f84f.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;s=0ac330eb7bf2b5780caca3aa8c382c02\" alt=\"image.png\" srcset=\"https://qiita-user-contents.imgix.net/https%3A%2F%2Fqiita-image-store.s3.ap-northeast-1.amazonaws.com%2F0%2F667288%2Ff894538b-39d3-f7ca-53ce-ddf34a27f84f.png?ixlib=rb-4.0.0&amp;auto=format&amp;gif-q=60&amp;q=75&amp;w=1400&amp;fit=max&amp;s=006ed156fdfdfab1a379126383d422cd 1x\" data-canonical-src=\"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/f894538b-39d3-f7ca-53ce-ddf34a27f84f.png\" loading=\"lazy\">\u003C/a>\n\u003C/li>\n\u003C/ul>\n","##概要\n* VSCodeからGitを使えるようにした際の備忘録\n* VSCodeとGit連携しておくと、Gitのコマンド入力（Pull/Push..etc)やブランチのチェックアウトが簡単にできるので便利◎\n\n##環境\n* Windows10 Home  x64-based PC\n* Ubuntu 20.04.2 LTS\n* git version 2.32.0.windows.1\n* Visual Studio Code ver:1.57.1\n\n\n\n##実施内容\n###1.Gitインストール\n\n* ↓の手順でGitをインストール\n\nhttps://qiita.com/nutsOst/items/86d00e6f31a66210b5da\n\n* ↓のコマンドを実行 (Ubuntu上で実行した)\n\n```\ngit config --global user.name {ユーザー名}\ngit config --global user.email {メールアドレス}\n```\n\n###2.VSCodeインストール\n\n↓のリンクからVisual Studio Codeをインストール\n\nhttps://azure.microsoft.com/ja-jp/products/visual-studio-code/\n\n###3.連携\n\n* 任意のフォルダをVSCodeで開く\n* ``Ctrl+Shift+@`` でターミナルを開く\n* ターミナルで``git init``を実行\n* \n```\n実行結果\nPS C:\\Users\\~~> git init\nInitialized empty Git repository in C:/Users/~~/.git/\n```\n\n* 左下に↓のようにBranch名が表示されていればOK\n![image.png](https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/f894538b-39d3-f7ca-53ce-ddf34a27f84f.png)\n\n\n\n\n\n\n\n\n\n",false,0,"2021-06-25T01:16:11+09:00",null,"82706a7160305978bac3",1,[13,16,19,22,25],{"name":14,"versions":15},"Windows",[],{"name":17,"versions":18},"Git",[],{"name":20,"versions":21},"Ubuntu",[],{"name":23,"versions":24},"VSCode",[],{"name":26,"versions":27},"WSL",[],"VSCodeとGitの連携方法","https://qiita.com/chimrindayo/items/82706a7160305978bac3",{"description":31,"facebook_id":31,"followees_count":7,"followers_count":7,"github_login_name":9,"id":32,"items_count":33,"linkedin_id":31,"location":31,"name":34,"organization":31,"permanent_id":35,"profile_image_url":36,"team_only":6,"twitter_screen_name":32,"website_url":31},"","chimrindayo",17,"chimrin",667288,"https://qiita-image-store.s3.ap-northeast-1.amazonaws.com/0/667288/profile-images/1731046053",4073,{"description":31,"facebook_id":31,"followees_count":7,"followers_count":7,"github_login_name":9,"id":32,"items_count":33,"linkedin_id":31,"location":31,"name":34,"organization":31,"permanent_id":35,"profile_image_url":36,"team_only":6,"twitter_screen_name":32,"website_url":31,"image_monthly_upload_limit":39,"image_monthly_upload_remaining":39},104857600,1744278646091]